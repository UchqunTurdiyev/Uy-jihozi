# ===== Sayt =====
# Saytning to'liq manzili (Telegramdagi havola shu manzilga olib boradi)
NEXT_PUBLIC_SITE_URL=https://uy-jihozi.vercel.app

# Forma yuborilgandan keyin mijoz yo'naltiriladigan Telegram kanal
NEXT_PUBLIC_TELEGRAM_CHANNEL_URL=https://t.me/your_channel

# ===== Meta Pixel + Conversions API =====
NEXT_PUBLIC_META_PIXEL_ID=000000000000000
# Events Manager -> Settings -> Conversions API -> Generate access token
META_CAPI_ACCESS_TOKEN=
# Test qilish uchun (Events Manager -> Test events). Ishga tushgach bo'sh qoldiring
META_TEST_EVENT_CODE=
# Purchase qiymati valyutasi. USD bo'lsa so'm kurs bo'yicha dollarga o'giriladi
META_CURRENCY=USD
UZS_PER_USD=12600

# ===== Telegram bot =====
TELEGRAM_BOT_TOKEN=
# Lidlar tushadigan chat / guruh ID (masalan -1001234567890)
TELEGRAM_CHAT_ID=

# ===== Xavfsizlik =====
# Lid havolasini shifrlash kaliti (kamida 32 ta tasodifiy belgi)
LEAD_SECRET=change-me-to-a-long-random-string-32chars
# Ixtiyoriy: Purchase sahifasida so'raladigan PIN kod
ADMIN_PIN=
